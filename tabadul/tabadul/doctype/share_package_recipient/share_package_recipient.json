{
 "doctype": "DocType",
 "name": "Share Package Recipient",
 "module": "Tabadul",
 "istable": 1,
 "editable_grid": 1,
 "engine": "InnoDB",
 "field_order": [
  "full_name",
  "email",
  "organisation",
  "phone",
  "col_r",
  "status",
  "nc_share_id",
  "nc_share_token",
  "share_url",
  "password_sent_via",
  "download_count",
  "error_message"
 ],
 "fields": [
  {
   "fieldname": "full_name",
   "fieldtype": "Data",
   "label": "Full name",
   "in_list_view": 1,
   "reqd": 1
  },
  {
   "fieldname": "email",
   "fieldtype": "Data",
   "options": "Email",
   "label": "Email",
   "in_list_view": 1,
   "reqd": 1
  },
  {
   "fieldname": "organisation",
   "fieldtype": "Data",
   "label": "Organisation",
   "in_list_view": 1
  },
  {
   "fieldname": "phone",
   "fieldtype": "Data",
   "label": "Mobile",
   "description": "Password delivery channel"
  },
  {
   "fieldname": "col_r",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "status",
   "fieldtype": "Select",
   "options": "\nNot created\nActive\nAwaiting manual delivery\nCancelled\nFailed",
   "label": "Status",
   "read_only": 1,
   "in_list_view": 1,
   "default": "Not created"
  },
  {
   "fieldname": "nc_share_id",
   "fieldtype": "Data",
   "label": "Share ID",
   "read_only": 1
  },
  {
   "fieldname": "nc_share_token",
   "fieldtype": "Data",
   "label": "Token",
   "read_only": 1,
   "hidden": 1
  },
  {
   "fieldname": "share_url",
   "fieldtype": "Small Text",
   "label": "Link",
   "read_only": 1
  },
  {
   "fieldname": "password_sent_via",
   "fieldtype": "Select",
   "options": "\nNot sent\nWhatsApp\nSMS\nPhone\nManually",
   "label": "Password delivery channel",
   "default": "Not sent"
  },
  {
   "fieldname": "download_count",
   "fieldtype": "Int",
   "label": "Download count",
   "read_only": 1,
   "description": "A count only — the platform provides no record of who downloaded"
  },
  {
   "fieldname": "error_message",
   "fieldtype": "Small Text",
   "label": "Error",
   "read_only": 1
  }
 ],
 "permissions": []
}
