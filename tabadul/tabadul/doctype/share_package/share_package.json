{
 "doctype": "DocType",
 "name": "Share Package",
 "module": "Tabadul",
 "engine": "InnoDB",
 "track_changes": 1,
 "autoname": "format:SHR-{YYYY}-{#####}",
 "naming_rule": "Expression",
 "title_field": "title",
 "field_order": [
  "sec_main",
  "title",
  "purpose",
  "col_m",
  "linked_doctype",
  "linked_name",
  "sec_content",
  "folder_path",
  "files",
  "sec_policy",
  "expires_on",
  "download_limit",
  "col_p",
  "allow_download",
  "status",
  "sec_recipients",
  "recipients",
  "sec_audit",
  "created_by_user",
  "created_on",
  "col_a",
  "cancelled_by",
  "cancelled_on",
  "cancel_reason",
  "audit_html"
 ],
 "fields": [
  {
   "fieldname": "sec_main",
   "fieldtype": "Section Break",
   "label": "Package"
  },
  {
   "fieldname": "title",
   "fieldtype": "Data",
   "label": "Title",
   "reqd": 1,
   "in_list_view": 1,
   "in_global_search": 1
  },
  {
   "fieldname": "purpose",
   "fieldtype": "Small Text",
   "label": "Purpose",
   "in_global_search": 1
  },
  {
   "fieldname": "col_m",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "linked_doctype",
   "fieldtype": "Link",
   "options": "DocType",
   "label": "Linked to"
  },
  {
   "fieldname": "linked_name",
   "fieldtype": "Dynamic Link",
   "options": "linked_doctype",
   "label": "Log"
  },
  {
   "fieldname": "sec_content",
   "fieldtype": "Section Break",
   "label": "Contents"
  },
  {
   "fieldname": "folder_path",
   "fieldtype": "Data",
   "label": "Folder path",
   "description": "Share a whole folder, or leave blank and list files below",
   "in_global_search": 1
  },
  {
   "fieldname": "files",
   "fieldtype": "Table",
   "options": "Share Package File",
   "label": "Selected files"
  },
  {
   "fieldname": "sec_policy",
   "fieldtype": "Section Break",
   "label": "Policy"
  },
  {
   "fieldname": "expires_on",
   "fieldtype": "Date",
   "label": "Expires on",
   "in_list_view": 1
  },
  {
   "fieldname": "download_limit",
   "fieldtype": "Int",
   "label": "Download limit",
   "description": "0 = no limit"
  },
  {
   "fieldname": "col_p",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "allow_download",
   "fieldtype": "Check",
   "label": "Allow download",
   "default": "1",
   "description": "When off: view only. Does not prevent screen capture"
  },
  {
   "fieldname": "status",
   "fieldtype": "Select",
   "options": "\nDraft\nActive\nExpired\nCancelled",
   "label": "Status",
   "default": "Draft",
   "read_only": 1,
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "sec_recipients",
   "fieldtype": "Section Break",
   "label": "Recipients"
  },
  {
   "fieldname": "recipients",
   "fieldtype": "Table",
   "options": "Share Package Recipient",
   "label": "Recipients",
   "reqd": 1
  },
  {
   "fieldname": "sec_audit",
   "fieldtype": "Section Break",
   "label": "Audit",
   "collapsible": 1
  },
  {
   "fieldname": "created_by_user",
   "fieldtype": "Link",
   "options": "User",
   "label": "Created by",
   "read_only": 1
  },
  {
   "fieldname": "created_on",
   "fieldtype": "Datetime",
   "label": "Created on",
   "read_only": 1
  },
  {
   "fieldname": "col_a",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "cancelled_by",
   "fieldtype": "Link",
   "options": "User",
   "label": "Cancelled by",
   "read_only": 1
  },
  {
   "fieldname": "cancelled_on",
   "fieldtype": "Datetime",
   "label": "Cancelled on",
   "read_only": 1
  },
  {
   "fieldname": "cancel_reason",
   "fieldtype": "Small Text",
   "label": "Cancellation reason",
   "read_only": 1
  },
  {
   "fieldname": "audit_html",
   "fieldtype": "HTML",
   "label": "Share log"
  }
 ],
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "email": 1,
   "export": 1,
   "print": 1,
   "report": 1,
   "share": 1
  }
 ]
}
